# AI-TeaM 环境配置
# ==================
# 方式一（推荐）：将以下变量设为系统环境变量
# 方式二：复制此文件为 .env.local 并填入你的 API Key
#   cp .env.example .env.local
#
# 不要直接编辑 .env.example，git 会追踪它的变更。

# 模型 API Key（至少设置一个）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# OPENAI_API_KEY=sk-your-openai-key-here
# GEMINI_API_KEY=your-gemini-key-here

# 自定义 API（可选，替换默认 DeepSeek/OpenAI 等）
# AI_TEAM_API_KEY=your-custom-api-key-here
# AI_TEAM_BASE_URL=https://your-custom-endpoint.com/v1

# 服务器配置（可选，默认值如下）
# AI_TEAM_HOST=127.0.0.1
# AI_TEAM_PORT=8123
