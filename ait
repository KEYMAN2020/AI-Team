#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
ait - AI-TeaM Harness CLI trigger (client-agnostic)
Usage:  ait "build a login system"
        ait status
        ait approve
"""

import subprocess, sys, json, time, os, urllib.request
from pathlib import Path

# Force UTF-8 on Windows to avoid GBK encoding errors
if sys.platform == "win32":
    import io
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding="utf-8", errors="replace")
    os.environ["PYTHONIOENCODING"] = "utf-8"  # pass to subprocesses

# API Key 从系统环境变量读取（DEEPSEEK_API_KEY 等），无需 .env 文件
SERVER_DIR = Path(__file__).resolve().parent

HOST = os.environ.get("AI_TEAM_HOST", "127.0.0.1")
PORT = os.environ.get("AI_TEAM_PORT", "8123")
BASE = f"http://{HOST}:{PORT}"


def _http(method, path, body=None):
    url = f"{BASE}{path}"
    data = json.dumps(body).encode() if body else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read())
    except Exception as e:
        return {"error": str(e)}


def _ensure_server():
    """Make sure server.py is running, start if needed."""
    try:
        r = _http("GET", "/health")
        if r.get("status") == "ok":
            print("[OK] server.py is online")
            return True
    except Exception:
        pass

    print("-> server.py not running, starting in background...")
    subprocess.Popen(
        [sys.executable, str(SERVER_DIR / "server.py")],
        cwd=str(SERVER_DIR),
        env={**os.environ},  # pass loaded env vars (incl .env) to server.py
    )
    for i in range(30):
        time.sleep(1)
        try:
            r = _http("GET", "/health")
            if r.get("status") == "ok":
                print("[OK] server.py started successfully")
                return True
        except Exception:
            pass
    print("[FAIL] server.py startup timed out")
    return False


def run(task: str, provider: str = "deepseek", project_name: str = ""):
    """Submit task to AI-TeaM Harness, wait for completion, return result."""

    if not _ensure_server():
        return {"error": "server.py could not be started"}

    if not project_name:
        project_name = task[:20].replace(" ", "_")

    print()
    print("=" * 60)
    print("[HARNESS] Submitting task to AI-TeaM (11-role DAG)")
    print(f"   Task: {task[:80]}")
    print(f"   Model: {provider}")
    print("=" * 60)
    print()

    resp = _http("POST", "/run", {
        "task": task,
        "provider": provider,
        "project_name": project_name,
    })
    task_id = resp.get("task_id")
    if not task_id:
        print(f"[FAIL] Submission failed: {resp}")
        return resp

    print(f"[OK] Task submitted: {task_id}")
    print()

    # Poll until done
    dots = 0
    while True:
        s = _http("GET", f"/status/{task_id}")
        status = s.get("status", "?")
        proj = s.get("project", {})
        phase = proj.get("current_phase", "?")
        progress = proj.get("overall_progress", 0)

        # Check for approval node
        if status in ("paused", "awaiting_approval"):
            print(f"\n[PAUSE] Human approval needed: {s.get('message', 'Please confirm')}")
            print(f"   Approve: ait approve {task_id}")
            print(f"   Reject:  ait reject {task_id}")
            while True:
                time.sleep(5)
                s2 = _http("GET", f"/status/{task_id}")
                if s2.get("status") not in ("paused", "awaiting_approval"):
                    s = s2
                    break

        if status in ("done", "error", "partial"):
            break

        dots = (dots + 1) % 4
        bar = "." * dots + " " * (3 - dots)
        print(f"\r[WAIT] Phase: {phase} | Progress: {progress}% {bar}", end="", flush=True)
        time.sleep(5)

    print()
    print()

    # Display results
    print("=" * 60)
    print(f"Status: {status}")
    if s.get("error"):
        print(f"\n[ERROR] {s['error']}")
    if s.get("result"):
        print(f"\n--- Final Report ---\n{s['result'][:4000]}")

    proj = s.get("project", {})
    if proj:
        print(f"\nProject: {proj.get('name', '?')} | Progress: {proj.get('overall_progress', '?')}%")
    print("=" * 60)
    return s


def approve(task_id: str = None, approved: bool = True, notes: str = ""):
    """Approve or reject a pending approval node."""
    if not task_id:
        s = _http("GET", "/status")
        for tid in s.get("active_tasks", []):
            ts = _http("GET", f"/status/{tid}")
            if ts.get("status") in ("paused", "awaiting_approval"):
                task_id = tid
                break
    if not task_id:
        print("No pending approvals")
        return
    _http("POST", "/approve", {"status": "reviewing", "notes": "Acknowledged"})
    time.sleep(1)
    _http("POST", "/approve", {"approved": approved, "notes": notes or ("Approved" if approved else "Rejected")})
    print(f"{'[OK] Approved' if approved else '[REJECTED]'} {task_id}")


def get_status(task_id: str = None):
    """Check status, auto-start server if needed."""
    if not _ensure_server():
        print(json.dumps({"error": "server.py could not be started"}, ensure_ascii=False))
        return
    path = f"/status/{task_id}" if task_id else "/status"
    s = _http("GET", path)
    print(json.dumps(s, ensure_ascii=False, indent=2))
    return s


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("AI-TeaM Harness CLI (ait)")
        print("  ait \"build a login system\"  - submit dev task")
        print("  ait status                   - view project status")
        print("  ait status <task_id>         - view task status")
        print("  ait approve                  - approve pending node")
        print("  ait reject                   - reject pending node")
        sys.exit(0)

    cmd = sys.argv[1]
    if cmd == "status":
        get_status(sys.argv[2] if len(sys.argv) > 2 else None)
    elif cmd == "approve":
        approve(approved=True)
    elif cmd == "reject":
        approve(approved=False)
    else:
        run(cmd)
